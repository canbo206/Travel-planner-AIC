# --- Required ---
# Local: docker compose up -d   (or your Supabase Postgres connection string)
DATABASE_URL="postgresql://roadtrip:roadtrip@localhost:5432/roadtrip"

PORT=4000
# Comma-separated list of allowed web origins
CORS_ORIGIN="http://localhost:5173"

# --- Auth ---
# "dev": no real auth, the web app sends an x-dev-user header (local only, never in production)
# "supabase": verify Supabase JWTs (set SUPABASE_URL)
AUTH_MODE=dev
SUPABASE_URL=""
# Only for legacy Supabase projects that sign JWTs with a shared secret (HS256)
SUPABASE_JWT_SECRET=""

# --- Routing + place search (optional) ---
# Free key at https://openrouteservice.org/dev/#/signup
# Without it, routes are straight-line estimates and place search uses a small built-in list.
ORS_API_KEY=""

# --- Photo uploads (optional) ---
# Supabase Storage: create a public bucket named below. The service role key must stay server-side.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="trip-photos"
