# URL of the Express API
VITE_API_URL="http://localhost:4000"

# Leave empty for local dev sign-in (pick a username, no password).
# Set both to use real Supabase Auth.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# MapLibre style. OpenFreeMap needs no API key.
VITE_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"
